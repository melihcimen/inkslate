#!/usr/bin/env python3
"""Launcher installed to ~/.local/bin by install.sh (the package lives next to it)."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(HERE, ".."), os.path.join(HERE, "..", "share", "inkslate")):
    if os.path.isdir(os.path.join(candidate, "inkslate")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from inkslate.app import main  # noqa: E402

sys.exit(main())
